PORT=5000
CORS_ORIGIN=https://your-vercel-app.vercel.app
DNS_RESULT_ORDER=ipv4first

#MongoDB URI
MONGODB_URI=your_mongodb_connection_string

#JWT SECRET
JWT_SECRET=replace_with_a_secure_secret

#Judge0 API 
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key

#Groq Integration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024

#Neura AI provider: groq | gemini | openai | deepseek (default: groq)
AI_PROVIDER=groq
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024

#Google Gemini (free tier) — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

#OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

#DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

#OTP VERIFICATION
GMAIL_USER=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM=Synapse <your_gmail_address>
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

#Brevo (recommended for OTP in production)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email
BREVO_SENDER_NAME=Synapse
